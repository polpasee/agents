# WebSocket server (scripts/ws-server.ts)
# Default: 4001. Changing this requires updating WS_ALLOWED_ORIGINS in scripts/lib/config.ts.
WS_PORT=4001
# Interface to bind the WS server to. Default: 0.0.0.0 (LAN-reachable, e.g. phone on http://192.168.x.y:4000). Set to 127.0.0.1 to restrict to localhost.
WS_HOST=0.0.0.0

# Client (Next.js)
# Default: ws://localhost:4001. Must match WS_PORT above.
NEXT_PUBLIC_WS_URL=ws://localhost:4001
